# Supabase Public Configuration
# Получите эти данные в панели Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# Учётная запись с правами на запись (используется только локальными
# импорт-скриптами типа import_all_bilingual_db.mjs, не включается в сборку)
IMPORT_ADMIN_EMAIL=admin@example.com
IMPORT_ADMIN_PASSWORD=change-me
