# Скопируйте этот файл в .env и впишите свои значения. Файл .env в git не попадает.

# --- Сайт (Vite): берутся в Supabase → Project Settings → API ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Имя Telegram-бота без @ (нужно для кнопки привязки Telegram на сайте)
VITE_TELEGRAM_BOT_USERNAME=

# --- Локальные скрипты импорта (в сборку сайта не попадают) ---
# Учётная запись администратора, от имени которой скрипты пишут в базу
IMPORT_ADMIN_EMAIL=
IMPORT_ADMIN_PASSWORD=

# --- Секреты Edge Functions (хранятся в Supabase, не в сайте) ---
# Задаются командой: npx supabase secrets set ИМЯ=значение --project-ref <ref>
# SUPABASE_URL и SUPABASE_SERVICE_ROLE_KEY Supabase подставляет сам.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Адрес Mini App (необязательно; по умолчанию адрес основного сайта + /tg)
MINIAPP_URL=
